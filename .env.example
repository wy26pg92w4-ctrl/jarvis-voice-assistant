# Base URL of the OmniRoute OpenAI-compatible gateway
# (https://github.com/diegosouzapw/OmniRoute), run locally via
# `npm install -g omniroute && omniroute` or
# `docker run -d --name omniroute -p 20128:20128 diegosouzapw/omniroute:latest`
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# API key configured for that OmniRoute instance (dashboard -> API Keys)
OMNIROUTE_API_KEY=

# Model id to request from OmniRoute, e.g. "auto" to let OmniRoute pick
# a free/available provider, or a specific model id like "claude-sonnet-5"
JARVIS_MODEL=auto

# How many past turns to keep in short-term conversation memory
JARVIS_MEMORY_TURNS=20
