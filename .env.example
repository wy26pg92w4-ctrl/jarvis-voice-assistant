# Base URL of the OmniRoute OpenAI-compatible gateway
# (https://github.com/diegosouzapw/OmniRoute), run locally via
# `npm install -g omniroute && omniroute` or
# `docker run -d --name omniroute -p 20128:20128 diegosouzapw/omniroute:latest`
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# API key configured for that OmniRoute instance (dashboard -> API Keys)
OMNIROUTE_API_KEY=

# Model id to request from OmniRoute, e.g. "auto" to let OmniRoute pick
# a free/available provider, or a specific model id like "claude-sonnet-5".
#
# To use a Hermes model (Nous Research): in the OmniRoute dashboard, add the
# "Nous Research" provider with a free API key from
# https://portal.nousresearch.com (free tier: 50 RPM / 500,000 TPM, no
# credit card). Then point JARVIS_MODEL at one of its models, e.g.:
#   JARVIS_MODEL=Hermes-4-70B
# Confirm the exact available model id for your OmniRoute instance with:
#   curl http://localhost:20128/v1/models -H "Authorization: Bearer $OMNIROUTE_API_KEY" | grep -i hermes
JARVIS_MODEL=auto

# How many past turns to keep in short-term conversation memory
JARVIS_MEMORY_TURNS=20

# --- Obsidian-Anbindung (optional) ---
# Gesetzt = Fakten, Erinnerungen und Gesprächs-Zusammenfassungen werden als
# Markdown-Notizen in diesen Ordner geschrieben (z. B. dein Obsidian-Vault
# oder ein Unterordner davon). Leer/nicht gesetzt = Obsidian-Anbindung aus.
JARVIS_OBSIDIAN_VAULT_PATH=

# Optional: zusätzliche Live-Synchronisation über die "Local REST API"-
# Community-Plugin einer laufenden Obsidian-App. Nur nötig, wenn Änderungen
# sofort in einer offenen Obsidian-Instanz sichtbar sein sollen — die
# Dateien im Vault-Ordner sind immer die Wahrheit, auch ohne das hier.
# Empfohlen: der Plugin-eigene Klartext-HTTP-Port (kein Zertifikatsproblem).
JARVIS_OBSIDIAN_REST_URL=http://127.0.0.1:27123
JARVIS_OBSIDIAN_REST_API_KEY=
