    "vault:quickadd": "tsx scripts/obsidian-quickadd-setup.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
