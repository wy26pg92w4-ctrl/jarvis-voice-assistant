{
  "name": "jarvis-voice-assistant",
  "version": "0.1.0",
  "description": "Jarvis brain: dialog orchestrator, skills and memory, backed by OmniRoute as the multi-provider LLM gateway.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
